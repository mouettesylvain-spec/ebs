{
  "name": "ebs-dashboard",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "uv run --project .. python ../scripts/dump_openapi.py openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "check:api": "uv run --project .. python ../scripts/dump_openapi.py openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts && git diff --exit-code -- openapi.json src/api/schema.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "elkjs": "0.12.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
