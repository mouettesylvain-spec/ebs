# Copy to .env (git-ignored) and fill in every password; compose refuses to start without them.
#   cp env.example .env && chmod 600 .env
# Generate values with e.g.: openssl rand -base64 24

# Superuser `postgres` (admin, PgBouncer admin console).
POSTGRES_PASSWORD=
# Application role `ebs` (the EBS metadata store connects as this role through PgBouncer).
EBS_PASSWORD=
# Streaming replication role `replicator` (used by the standby).
REPLICATION_PASSWORD=
# pgBackRest repository encryption key. Losing it makes every backup unreadable: keep a copy in
# the site's secret store, outside this host.
PGBACKREST_REPO1_CIPHER_PASS=

# Optional settings.
# Host directory with ca.crt, server.crt and server.key (default: ./certs).
# EBS_PG_CERT_DIR=./certs
# Port PgBouncer listens on, on 127.0.0.1 of the Docker host (default: 6432).
# EBS_PGBOUNCER_PORT=6432
# Backend PgBouncer starts with; set to `standby` after a failover (default: primary).
# EBS_PG_PRIMARY_HOST=primary
