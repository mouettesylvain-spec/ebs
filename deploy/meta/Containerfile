# EBS metadata service image (P1-06). Build context: the repository root.
#   docker compose -f deploy/meta/compose.yaml build
FROM python:3.12-slim

# `unmunge` verifies MUNGE credentials against the host's munged (socket mounted at /run/munge).
RUN apt-get update \
 && apt-get install -y --no-install-recommends munge \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock README.md LICENSE NOTICE /src/
COPY src /src/src
RUN pip install --no-cache-dir /src && rm -rf /src

RUN useradd --system --uid 990 --home-dir /nonexistent --shell /usr/sbin/nologin ebs-meta
USER ebs-meta
ENV EBS_CONFIG=/etc/ebs/config.toml
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=4).status != 200)"]
CMD ["uvicorn", "--factory", "ebs.meta.service.app:app_from_config", \
     "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--workers", "4"]
