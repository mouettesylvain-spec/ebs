; {{ ansible_managed }}
; Mirrors deploy/postgres/conf/pgbouncer.ini. After a failover, point `ebs` at the new primary
; (set ebs_postgres_primary_host / re-run the role, or edit and `systemctl reload pgbouncer`).

[databases]
ebs = host=127.0.0.1 port=5432 dbname=ebs

[pgbouncer]
listen_addr = *
listen_port = {{ ebs_pgbouncer_port }}
unix_socket_dir = /var/run/postgresql

auth_type = scram-sha-256
auth_file = /etc/pgbouncer/userlist.txt
admin_users = postgres
stats_users = ebs

pool_mode = {{ ebs_pgbouncer_pool_mode }}
default_pool_size = {{ ebs_pgbouncer_default_pool_size }}
reserve_pool_size = {{ ebs_pgbouncer_reserve_pool_size }}
reserve_pool_timeout = 3
max_db_connections = {{ ebs_pgbouncer_max_db_connections }}
max_client_conn = {{ ebs_pgbouncer_max_client_conn }}
server_reset_query = DISCARD ALL
ignore_startup_parameters = extra_float_digits,options

client_tls_sslmode = require
client_tls_cert_file = {{ ebs_postgres_tls_dir }}/server.crt
client_tls_key_file = {{ ebs_postgres_tls_dir }}/server.key
client_tls_ca_file = {{ ebs_postgres_tls_dir }}/ca.crt
server_tls_sslmode = require
server_tls_ca_file = {{ ebs_postgres_tls_dir }}/ca.crt

log_connections = 1
log_disconnections = 1
